# ---------------------------------------------------------------------------
# PATIENT DATA NEVER GOES IN THIS REPO.
# Individual-level TBweb/SIM records are shared via Google Drive only.
# They carry sinan_clean (SINAN notification ID), dob, dod, death_date,
# tx_city and address_type alongside HIV status, homelessness and
# incarceration history -- directly identifying, and covered by an ethics
# approval for secondary use that does not extend to publication.
# ---------------------------------------------------------------------------
Data/
ITT_Analysis/data/
ITT_Analysis/results_incl_no_tx_start_backup/
**/cause_lookup*.csv
**/itt_cohort*.csv
**/imp_0*.csv
**/analytic_*.csv
**/*_ids.csv

# Manuscript and internal reports are shared via Google Drive, not here
*.docx
*.doc
*.gdoc
~$*

# Superseded CCW v1 figures (produced before the cause-attribution fix)
Figure_CCW_*.png

# IBGE source workbook: re-downloaded by 47_build_ibge_typology.py
ITT_Analysis/external/*.xlsx

.DS_Store
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Project working notes stay in Google Drive, not in this repo.
# ---------------------------------------------------------------------------
docs/
CLAUDE.md
check.sh
.claude/
tools/*
!tools/check_no_patient_data.py
# 48_make_literature_docx.py stays in Google Drive: it hardcodes the manuscript's
# effect estimates and the prior-literature comparison, i.e. unpublished results.
ITT_Analysis/scripts/48_make_literature_docx.py

# Figure scripts that hardcode unpublished effect estimates (and, for 61, the
# private revision path) so they can be rendered into the figure itself. Same
# reason 48_make_literature_docx.py is excluded: this repo is public and the
# estimates are under review. Both live in Google Drive.
ITT_Analysis/scripts/61_fig_design_schematic.py
ITT_Analysis/scripts/73_make_fig4_revised.py

# Agent tooling: per-user permission grants, and agent worktrees (which are full
# embedded repo copies). Note gitignore has no trailing comments — a pattern with
# a comment appended to the same line matches nothing.
.claude/settings.local.json
.claude/worktrees/
